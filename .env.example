# Run python3 scripts/configure.py to create .env with independent random secrets.
OWNER_TOKEN=
INTERNAL_TOKEN=
SUPERVISOR_TOKEN=
RESEARCHER_TOKEN=
WRITER_TOKEN=
REVIEWER_TOKEN=
RESEARCHER_API_KEY=
WRITER_API_KEY=
REVIEWER_API_KEY=
POSTGRES_PASSWORD=
STORAGE_PASSWORD=
# A separate 32-byte URL-safe base64 key encrypts persisted model/runtime credentials.
CONFIG_ENCRYPTION_KEY=
PUBLIC_URL=http://localhost:8780
# Hermes uses the custom OpenAI-compatible route. Configure your chosen provider.
MODEL_NAME=
MODEL_BASE_URL=
MODEL_API_KEY=
# Optional local ChatGPT broker: setup script saves the non-secret verifier path here.
MODEL_BROKER_PAIRING_FILE=
# Definite transient execution failures may recover only before any tool ran.
MAX_RECOVERIES=2

# Optional browser push: generate once with scripts/notification_setup.py --contact mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
